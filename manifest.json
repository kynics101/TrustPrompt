{
  "manifest_version": 3,
  "name": "TrustPrompt (dev test)",
  "version": "0.0.4",
  "description": "Screens user prompts for sensitive data before submission to AI assistants.",

  "permissions": [
    "storage",
    "scripting",
    "sidePanel"
  ],

  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": [
        "lib/validator.min.js",
        "lib/compromise.min.js",
        "ph-address-db.js",
        "terms-identity.js",
        "normalizer.js",
        "patterns.js",
        "terms-medical.js",
        "terms-financial.js",
        "terms-organizations.js",
        "terms-occupations.js",
        "terms-names.js",
        "terms-names-extra.js",
        "context-attribution.js",
        "gazetteer.js",
        "organization-loader.js",
        "organization-detector-enhanced.js",
        "linguistic-detector.js",
        "validator-wrapper.js",
        "scanner.js",
        "worker-bridge.js",
        "ui.js",
        "consent-state.js",
        "dom-claude.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "lib/validator.min.js",
        "lib/compromise.min.js",
        "ph-address-db.js",
        "terms-identity.js",
        "normalizer.js",
        "patterns.js",
        "terms-medical.js",
        "terms-financial.js",
        "terms-organizations.js",
        "terms-occupations.js",
        "terms-names.js",
        "terms-names-extra.js",
        "context-attribution.js",
        "gazetteer.js",
        "organization-loader.js",
        "organization-detector-enhanced.js",
        "linguistic-detector.js",
        "validator-wrapper.js",
        "scanner.js",
        "worker-bridge.js",
        "ui.js",
        "consent-state.js",
        "dom-chatgpt.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "TrustPrompt",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "lib/validator.min.js",
        "lib/compromise.min.js",
        "terms-identity.js",
        "normalizer.js",
        "patterns.js",
        "terms-medical.js",
        "terms-financial.js",
        "terms-organizations.js",
        "terms-occupations.js",
        "terms-names.js",
        "terms-names-extra.js",
        "context-attribution.js",
        "gazetteer.js",
        "organization-loader.js",
        "organization-detector-enhanced.js",
        "linguistic-detector.js",
        "ph-address-db.js",
        "validator-wrapper.js",
        "validator-wrapper-worker.js",
        "scanner.js",
        "worker-data-bundle.js",
        "trust-worker.js"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    }
  ]
}

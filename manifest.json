{
  "manifest_version": 3,
  "name": "TrustPrompt (dev test)",
  "version": "0.0.2",
  "description": "Screens user prompts for sensitive data before submission to AI assistants.",

  "permissions": [
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "lib/validator.min.js",
        "ph-address-db.js",
        "patterns.js",
        "validator-wrapper.js",
        "content-script-chatgpt.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "web_accessible_resources": [
    {
      "resources": ["lib/validator.min.js"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    }
  ]
}
